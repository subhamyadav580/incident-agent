# Copy to .env and fill in. Never commit .env.

# ---- Model provider -------------------------------------------------------
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ---- Elasticsearch plugin -------------------------------------------------
ES_HOSTS=http://localhost:9200            # comma-separated for multiple nodes
# ES_API_KEY=                             # API key auth, or:
# ES_USERNAME=
# ES_PASSWORD=
# ES_VERIFY_CERTS=true
# ES_CA_CERTS=/path/to/ca.pem

# ---- Postgres plugin ------------------------------------------------------
# One <NAME>_DATABASE_URL per database; <name> is how the agent refers to it.
# Use a read-only role.
ORDERS_DATABASE_URL=postgresql://readonly:password@localhost:5432/orders
ORDERS_DATABASE_DESC=Orders, payments and fulfilment state
# INVENTORY_DATABASE_URL=postgresql://readonly:password@localhost:5432/inventory
# INVENTORY_DATABASE_DESC=Stock levels and reservations
DEFAULT_DATABASE=orders
