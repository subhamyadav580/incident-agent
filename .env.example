# Copy to .env and fill in. Never commit .env.
# Everything else (connectors, credentials, model, instructions) is configured
# in the web UI and stored in the app database.

# Local PostgreSQL for the app's own data; the database is created if missing.
APP_DATABASE_URL=postgresql://localhost:5432/incident_agent

# Encrypts stored credentials. Generate: incident-agent-server --generate-key
# Keep it safe: without it stored passwords cannot be decrypted.
APP_SECRET_KEY=

# Optional: model provider key, if you don't set one in Settings.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Local working data, e.g. clones of remote Git repositories.
# APP_DATA_DIR=~/.incident-agent
# APP_HOST=127.0.0.1
# APP_PORT=8000
